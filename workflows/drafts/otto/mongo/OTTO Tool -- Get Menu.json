    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst menu = {};\n\nfor (const item of items) {\n  const r = item.json;\n  if (!r.item || !r.price) continue;\n  if (!menu[r.category]) menu[r.category] = [];\n  const desc = r.description ? ` (${r.description})` : '';\n  menu[r.category].push(`${r.item} - Rs. ${r.price}${desc}`);\n}\n\nlet menuText = 'CURRENT MENU:\\n';\nfor (const [cat, list] of Object.entries(menu)) {\n  menuText += `\\n${cat}:\\n`;\n  for (const line of list) {\n    menuText += `- ${line}\\n`;\n  }\n}\n\nreturn [{ json: { response: menuText } }];"
      },
      "id": "a1000001-0001-0001-0001-000000000003",
