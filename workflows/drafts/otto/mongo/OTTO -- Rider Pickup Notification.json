{
  "name": "OTTO -- Rider Pickup Notification",
  "nodes": [
    {
      "parameters": {
        "content": "## OTTO -- Rider Pickup Notification\n\nPolls the Order collection (MongoDB) every minute. When status = \"on_the_way\" and riderNotified is not yet true, sends a WhatsApp message via the bridge and marks the order as notified so it never fires twice.\n\n**Requires:**\n- Order documents must have a `jid` field (set by the main bot when the order is placed). Orders without a jid cannot be notified.\n- Staff must set status to exactly \"on_the_way\" when handing the order to a rider.",
        "height": 448,
        "width": 480,
        "color": 5
      },
      "id": "2b03020d-3225-4f47-9f04-8380bb5cee48",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        224,
        -416
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "dbf59da7-b79a-4cfa-86b2-a78113a8c9f6",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        128
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "BRIDGE_URL",
              "value": "http://localhost:3000",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "07f21e0d-24ce-49c5-8f53-89b6faa1c350",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        464,
        128
      ]
    },
    {
      "parameters": {
        "operation": "find",
        "collection": "Order",
        "query": "{\"status\": \"on_the_way\", \"riderNotified\": {\"$ne\": true}}",
        "options": {}
      },
      "id": "845918a5-d774-422e-a16f-44a6fb939c00",
      "name": "Read All Orders",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.3,
      "position": [
        688,
        128
      ],
      "credentials": {
        "mongoDb": {
          "id": "MONGO_CRED_ID",
          "name": "MongoDB account"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.orderId);\n\n// Status is an enum in Mongo (on_the_way); the query already filters it, this is a safety net.\nconst isOnTheWay = (r) => String(r.status || '').toLowerCase().includes('on_the_way');\nconst notYetNotified = (r) => r.riderNotified !== true;\n\nconst pending = rows.filter(r => isOnTheWay(r) && notYetNotified(r));\n\n// Orders without a jid can't be addressed -- skip them, don't error the whole batch.\nconst sendable = pending.filter(r => r.jid && String(r.jid).trim());\nconst skippedNoJid = pending.length - sendable.length;\nif (skippedNoJid > 0) {\n  console.log('Skipped ' + skippedNoJid + ' order(s) with status on the way but no jid stored.');\n}\n\nreturn sendable.map(r => ({ json: r }));"
      },
      "id": "c691128c-e23b-462b-9957-136845d4b603",
      "name": "Find Newly On-The-Way Orders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\nreturn items.map(row => {\n  const orderItems = Array.isArray(row.items) ? row.items : [];\n  const itemLines = orderItems.map(i => (i.name || 'Item') + ' x' + (i.qty || 1)).join(', ');\n\n  const message = 'Assalam o Alaikum! Aap ka order (' + itemLines + ') rider ke pass pohanch gaya hai ' +\n    'aur jald hi aapke address par pohanch jayega. Order ID: ' + row.orderId + '.';\n\n  return {\n    json: {\n      _id: String(row._id),\n      jid: row.jid,\n      message: message\n    }\n  };\n});"
      },
      "id": "8fee5cd8-a365-4f11-b8f9-aae4f9a56724",
      "name": "Build Rider Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.BRIDGE_URL + '/send' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.jid, message: $json.message }) }}",
        "options": {}
      },
      "id": "ff821d14-f0ad-475b-8725-2a1bc0dec65e",
      "name": "Send Rider Pickup Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1360,
        128
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "findOneAndUpdate",
        "collection": "Order",
        "updateKey": "_id",
        "fields": "riderNotified",
        "upsert": false,
        "options": {}
      },
      "id": "baae193e-2c52-47ac-a45c-2ad82d6702b7",
      "name": "Mark Rider Notified",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.3,
      "position": [
        1584,
        128
      ],
      "credentials": {
        "mongoDb": {
          "id": "MONGO_CRED_ID",
          "name": "MongoDB account"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// The HTTP node output has no order data, so rebuild one update item per order from 'Build Rider Message'.\nreturn $('Build Rider Message').all().map(i => ({ json: { _id: i.json._id, riderNotified: true } }));"
      },
      "id": "5845efe5-14af-4e10-9152-7f1be67722ac",
      "name": "Build Rider Notified Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1584,
        298
      ]
    }
  ],
  "connections": {
