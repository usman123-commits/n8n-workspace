{
  "name": "OTTO Tool -- Check Previous Order For Cancellation",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "phone"
            }
          ]
        }
      },
      "id": "c412985c-12b6-40fd-84b9-ac311376929a",
      "name": "When Called by AI Agent",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -1104,
        192
      ]
    },
    {
      "parameters": {
        "operation": "find",
        "collection": "Order",
        "query": "={{ JSON.stringify({ phone: $json.phone }) }}",
        "options": {
          "sort": "{\"timestamp\": -1}",
          "limit": 1
        }
      },
      "id": "f1708f6e-d283-4387-bbad-7fe188a8a836",
      "name": "Read Orders By Phone",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.3,
      "position": [
        -880,
        192
      ],
      "credentials": {
        "mongoDb": {
          "id": "MONGO_CRED_ID",
          "name": "MongoDB account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.orderId);\nif (rows.length === 0) {\n  return [{ json: { found: false, phone: $('When Called by AI Agent').first().json.phone } }];\n}\n\nrows.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));\nconst row = rows[0];\n\nconst items = Array.isArray(row.items) ? row.items : [];\n\nreturn [{\n  json: {\n    found: true,\n    actionable: row.status === 'preparing',\n    orderId: row.orderId,\n    items,\n    total: row.totalAmount,\n    address: row.deliveryAddress,\n    status: row.status,\n    timestamp: row.timestamp,\n    phone: row.phone\n  }\n}];"
      },
      "id": "acea92f2-1173-452d-9f1f-39021592ceab",
      "name": "Pick Most Recent Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
        192
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ $json.found }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "dfae6ccc-1fb5-42ce-8bfd-5b09646d1ef1",
      "name": "Order Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -432,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "a1",
              "leftValue": "={{ $json.actionable }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7d24522d-414d-4534-8f86-0f2f3ba967c5",
      "name": "Is Actionable? (status = preparing)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -208,
        96
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "collection": "pendingCancellations",
        "fields": "phone,timestamp,orderId,items,total,address,status,awaitingConfirmation,workflowName,workflowId,executionId",
        "options": {
          "dateFields": "timestamp"
        }
      },
      "id": "50e3ff10-f4bc-4670-a521-bd31cd751f2c",
      "name": "Append Pending Cancellation Row",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.3,
      "position": [
        16,
        0
      ],
      "credentials": {
        "mongoDb": {
          "id": "MONGO_CRED_ID",
          "name": "MongoDB account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const o = $('Pick Most Recent Order').first().json;\nconst itemLines = (o.items || []).map(i => '- ' + i.name + ' x' + i.qty).join('\\n');\nconst response = 'Order ID: ' + o.orderId + '\\nItems:\\n' + itemLines +\n  '\\nTotal: Rs. ' + o.total + '\\nAddress: ' + o.address +\n  '\\nStatus: ' + o.status + '\\nPlaced at: ' + o.timestamp +\n  '\\nThis order can still be cancelled or modified -- present these exact details to the customer and ask them to confirm cancel/modify vs keep, as a numbered list.';\n\nreturn [{\n  json: {\n    response,\n    found: true,\n    actionable: true,\n    orderId: o.orderId,\n    items: o.items,\n    total: o.total,\n    address: o.address,\n    status: o.status,\n    timestamp: o.timestamp\n  }\n}];"
      },
      "id": "6475b45d-a68e-4249-97e9-98ef844df87f",
      "name": "Respond Found Actionable",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const o = $('Pick Most Recent Order').first().json;\nconst response = 'Order ID: ' + o.orderId + '\\nStatus: ' + o.status + '\\nPlaced at: ' + o.timestamp +\n  '\\nThis order is already ' + o.status + ' and can no longer be cancelled or modified -- ' +\n  'explain this to the customer with the timestamp, do not ask for cancel/modify confirmation.';\n\nreturn [{\n  json: {\n    response,\n    found: true,\n    actionable: false,\n    orderId: o.orderId,\n    status: o.status,\n    timestamp: o.timestamp\n  }\n}];"
      },
      "id": "7f504c55-05ad-453c-a278-d6b49f20ccbd",
      "name": "Respond Found Not Actionable",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    response: 'No previous order found for this customer -- tell them you could not find a previous order and ask what they would like to do.',\n    found: false\n  }\n}];"
      },
      "id": "e44684e5-4139-48e3-9ffd-04b75200cb95",
      "name": "Respond Not Found",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -208,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "// Data source: $json = output of 'Is Actionable? (status = preparing)' (pass-through of 'Pick Most Recent Order')\n//   -> phone, orderId, items (array), total, address, status\nconst o = $json;\nconst total = Number(o.total);\n\nreturn [{ json: {\n  phone: String(o.phone),\n  orderId: o.orderId,\n  items: o.items,\n  total: isFinite(total) ? total : String(o.total),\n  address: o.address || '',\n  status: o.status,\n  timestamp: new Date().toISOString(),\n  awaitingConfirmation: true,\n  workflowName: $workflow.name,\n  workflowId: $workflow.id,\n  executionId: $execution.id\n} }];"
      },
      "id": "c9ac8282-c241-4b44-9860-1639d4d1df2f",
      "name": "Build Pending Cancellation Doc",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
        170
      ]
    }
  ],
