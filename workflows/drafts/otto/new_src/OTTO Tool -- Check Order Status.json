    {
      "parameters": {
        "jsCode": "const orders = $input.all();\nconst valid = orders.filter(o => o.json.orderId && o.json.status);\nif (valid.length === 0) return [{ json: { response: 'No orders found for this customer.' } }];\n\nconst latest = valid[valid.length - 1].json;\n\nreturn [{\n  json: {\n    response: `Order ID: ${latest.orderId}\nItems: ${latest.items}\nTotal: Rs. ${latest.totalAmount}\nStatus: ${latest.status}\nAddress: ${latest.deliveryAddress || 'not set'}\nStatus meanings: preparing = kitchen is making it, on_the_way = rider has picked it up and is on the way to customer, delivered = already delivered, cancelled = order was cancelled.`\n  }\n}];"
      },
