      "parameters": {
        "jsCode": "const trigger = $('When Executed by Another Workflow').first().json;\n\nfunction parseItems(raw) {\n  if (Array.isArray(raw)) return raw;\n  if (raw && typeof raw === 'object') return raw;\n  if (typeof raw === 'string' && raw.trim()) {\n    try { return JSON.parse(raw); } catch (e) { return []; }\n  }\n  return [];\n}\n\nconst items = parseItems(trigger.items);\nconst total = parseFloat(trigger.total);\n\nconst validItems = Array.isArray(items) && items.length > 0 &&\n  items.every(i => i && typeof i.name === 'string' && i.name.trim().length > 0);\nconst validTotal = !isNaN(total) && total > 0;\n\nreturn [{ json: { valid: validItems && validTotal } }];"
      },
