    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst trigger = $('When Executed by Another Workflow').first().json;\n\nif (rows.length === 0) {\n  return [{ json: { isDuplicate: false, reason: 'no_previous_orders' } }];\n}\n\nrows.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));\nconst newest = rows[0];\n\nconst minutesSinceLastOrder = (Date.now() - new Date(newest.timestamp).getTime()) / 60000;\n\nlet newItems = [];\nlet itemsParsedOk = true;\ntry { newItems = JSON.parse(trigger.items || '[]'); } catch (e) { itemsParsedOk = false; }\nlet lastItems = [];\ntry { lastItems = JSON.parse(newest.items || '[]'); } catch (e) {}\n\nfunction normalize(items) {\n  return items\n    .map(i => (String(i.name || '').trim().toLowerCase()) + '::' + (i.qty || 1))\n    .sort()\n    .join('|');\n}\n\nconst itemsMissing = newItems.length === 0;\nconst rawItemsMatch = normalize(newItems) === normalize(lastItems);\nconst itemsMatch = itemsMissing ? false : rawItemsMatch;\n\nconst withinWindow = minutesSinceLastOrder <= 30;\n\nconst isDuplicate = withinWindow || itemsMatch;\n\nlet reason = 'not_duplicate';\nif (isDuplicate) {\n  if (withinWindow && itemsMatch) reason = 'same_order_within_30min';\n  else if (withinWindow && !itemsMatch) reason = 'different_order_within_30min';\n  else if (!withinWindow && itemsMatch) reason = 'same_order_after_30min';\n}\n\nreturn [{\n  json: {\n    isDuplicate,\n    reason,\n    itemsMatch,\n    itemsMissing,\n    itemsParsedOk,\n    minutesSinceLastOrder: Math.round(minutesSinceLastOrder),\n    lastOrderId: newest.orderId,\n    lastOrderItems: newest.items,\n    lastOrderTotal: newest.totalAmount,\n    lastOrderStatus: newest.status\n  }\n}];"
      },
